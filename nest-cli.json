{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "persistence/postgres/drizzle/**/*",
        "outDir": "dist"
      },
      {
        "include": "persistence/postgres/drizzle/meta/_journal.json",
        "outDir": "dist"
      }
    ]
  }
}
